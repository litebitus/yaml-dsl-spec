{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "listener": {
      "type": "object",
      "unevaluatedProperties": false,
      "properties": { "kind": { "type": "string" }, "port": { "type": "integer" } },
      "if": { "properties": { "kind": { "const": "mock-tls" } }, "required": ["kind"] },
      "then": { "properties": { "certificate": { "type": "string" } } }
    }
  }
}
