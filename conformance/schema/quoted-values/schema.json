{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "enabled": { "type": "boolean" },
    "count": { "type": "integer" },
    "count_written_as_fraction": { "type": "integer" },
    "ratio": { "type": "number" },
    "either": { "type": ["integer", "string"] },
    "spelled_otherwise": { "type": "boolean" },
    "inside_alternatives": { "anyOf": [{ "type": "boolean" }, { "type": "array" }] }
  }
}
