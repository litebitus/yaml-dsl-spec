{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-yaml-dsl-functions": {
    "merge": {
      "description": "Merges the contents into the map holding the call, its own keys winning.",
      "arguments": [
        {
          "name": "contents",
          "type": "map",
          "required": true,
          "repeated": true,
          "description": "The maps merged in, in order."
        }
      ],
      "macro": { "kind": "merge", "content": "contents", "merge_behavior": "deep" }
    }
  },
  "type": "object",
  "properties": {
    "queue": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["visibility", "tags"],
        "additionalProperties": false,
        "properties": {
          "visibility": { "type": "integer" },
          "retention": { "type": "integer" },
          "tags": { "type": "object" }
        }
      }
    }
  }
}
