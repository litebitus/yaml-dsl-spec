{
  "name": "yaml-dsl-spec",
  "version": "0.3.3",
  "description": "The YAML DSL standard: the JSON Schemas of yaml-dsl.yml and of a DSL's function table, and a reader returning a yaml-dsl.yml's DSL definitions validated.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/litebitus/yaml-dsl-spec.git",
    "directory": "javascript"
  },
  "main": "index.js",
  "files": [
    "index.js",
    "lib/*.js",
    "schema-versions.js",
    "schemas/*-v*.schema.json"
  ],
  "scripts": {
    "build": "node scripts/copy-schemas.js",
    "pretest": "npm run build",
    "test": "node --test --test-timeout=5000 --test-force-exit --experimental-test-coverage --test-coverage-exclude=test/** --test-coverage-lines=90 test/",
    "prepack": "npm run build"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "yaml": "2.9.1"
  }
}
